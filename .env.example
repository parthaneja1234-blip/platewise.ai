# ==============================================================================
# PlateWise AI — Environment Variables Template
# Copy this file to .env and replace secrets with secure, randomly generated values.
# NEVER commit the real .env file to version control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
POSTGRES_USER=platewise
POSTGRES_PASSWORD=replace_with_strong_db_password_min_16_chars
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=platewise_db
# In Docker Compose, the server is 'postgres'
# DATABASE_URL=postgresql+psycopg://platewise:replace_with_strong_db_password_min_16_chars@postgres:5432/platewise_db
DATABASE_URL=postgresql+psycopg://platewise:replace_with_strong_db_password_min_16_chars@localhost:5432/platewise_db

# Security & Cryptography (Generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_openssl_rand_hex_32_jwt_access_secret_key
REFRESH_SECRET_KEY=replace_with_openssl_rand_hex_32_jwt_refresh_secret_key
CSRF_SECRET=replace_with_openssl_rand_hex_32_csrf_secret_token_key

# Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security
COOKIE_SECURE=false # Set to true in production (HTTPS required)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_LOGIN=5/15minutes
RATE_LIMIT_GLOBAL=100/minute
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# University Dining Defaults & Impact Calculations
# Cost of food per kg in Indian Rupees (INR)
DEFAULT_COST_PER_KG_INR=45.0
# Emission factor in kg CO2e per kg organic food waste avoided (IPCC & FAO reference)
DEFAULT_EMISSION_FACTOR_CO2E=2.5

# External Integrations (Optional)
# OPENWEATHER_API_KEY=
WEATHER_CACHE_TTL_HOURS=6

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
